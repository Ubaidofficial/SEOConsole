{
	"name": "seoconsole",
	"private": true,
	"version": "0.1.0",
	"license": "AGPL-3.0-only",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node scripts/start.mjs",
		"serve": "vite build && node scripts/start.mjs",
		"get-latest": "git fetch origin && git checkout main && git pull --ff-only && pnpm install",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"hash-password": "node scripts/hash-password.mjs",
		"cloud:build": "vite build --config cloud/vite.config.ts",
		"cloud:start": "node cloud/dist/main.js",
		"cloud:check": "tsc -p cloud/tsconfig.json",
		"test": "vitest run --passWithNoTests"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^22.0.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"vite": "^8.3.7",
		"vitest": "^4.1.12"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "1.8.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@lucide/svelte": "^1.71.0",
		"better-sqlite3": "^12.11.1",
		"bits-ui": "^2.20.6",
		"clsx": "^2.1.1",
		"svelte-sonner": "^1.2.3",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^4.0.2",
		"tw-animate-css": "^1.4.0"
	}
}
